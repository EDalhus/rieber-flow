{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rieber-flow",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Web-appen (Vite-build) serveres som statiske filer fra samme Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // D1 opprettes automatisk ved første `wrangler deploy` (ingen database_id nødvendig).
  // Schema + mock-data legges inn automatisk ved første API-kall.
  "d1_databases": [{ "binding": "DB", "database_name": "rieber-flow-db" }],
  // Behold variabler/secrets som er lagt inn i Cloudflare-dashbordet (f.eks. BARENTSWATCH_*) ved hver deploy
  "keep_vars": true,
  "observability": { "enabled": true }
}
